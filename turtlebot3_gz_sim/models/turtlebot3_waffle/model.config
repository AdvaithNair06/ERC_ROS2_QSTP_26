<?xml version="1.0"?>
<model>
  <name>turtlebot3_waffle (Gazebo Fortress / ign gazebo)</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <author>
    <name>turtlebot3_gz_sim</name>
  </author>
  <description>
    TurtleBot3 waffle converted for Gazebo Fortress (ignition-gazebo
    systems instead of gazebo_ros plugins). Meshes are re-used from the
    turtlebot3_gazebo (classic) package via GZ_SIM_RESOURCE_PATH.
  </description>
</model>
